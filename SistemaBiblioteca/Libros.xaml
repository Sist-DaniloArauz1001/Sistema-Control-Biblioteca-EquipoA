<Window x:Class="SistemaBiblioteca.Libros"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Libros"
        Height="550"
        Width="950"
        Background="#12121C"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <LinearGradientBrush x:Key="BotonDegradado" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A12BFF" Offset="0.0" />
            <GradientStop Color="#2B6BFF" Offset="0.5" />
            <GradientStop Color="#00D2FF" Offset="1.0" />
        </LinearGradientBrush>

        <Style x:Key="BotonEstilo" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BotonDegradado}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#1E1E2E"
                CornerRadius="20"
                Padding="20"
                Margin="0,0,20,0">
            <StackPanel>
                <TextBlock Text="GESTIÓN DE LIBROS"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Black"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Título" Foreground="#8888A0" FontWeight="SemiBold"/>
                <TextBox x:Name="txtTitulo" Height="32" Margin="0,5,0,15"/>

                <TextBlock Text="Autor" Foreground="#8888A0" FontWeight="SemiBold"/>
                <TextBox x:Name="txtAutor" Height="32" Margin="0,5,0,15"/>

                <TextBlock Text="Categoría" Foreground="#8888A0" FontWeight="SemiBold"/>
                <TextBox x:Name="txtCategoria" Height="32" Margin="0,5,0,15"/>

                <TextBlock Text="Stock" Foreground="#8888A0" FontWeight="SemiBold"/>
                <TextBox x:Name="txtStock" Height="32" Margin="0,5,0,25"/>

                <UniformGrid Columns="2" Rows="2" HorizontalAlignment="Stretch">
                    <Button Style="{StaticResource BotonEstilo}" Content="Agregar" Height="38" Margin="0,0,5,10" Click="BtnAgregar_Click"/>
                    <Button Style="{StaticResource BotonEstilo}" Content="Editar" Height="38" Margin="5,0,0,10" Click="BtnEditar_Click"/>
                    <Button Style="{StaticResource BotonEstilo}" Content="Eliminar" Height="38" Margin="0,0,5,10" Click="BtnEliminar_Click"/>
                    <Button Style="{StaticResource BotonEstilo}" Content="Limpiar" Height="38" Margin="5,0,0,10" Click="BtnLimpiar_Click"/>
                </UniformGrid>

                <Button x:Name="BtnMostrar" Style="{StaticResource BotonEstilo}" Content="CARGAR BASE DE DATOS" Height="45" Margin="0,15,0,0" Click="BtnMostrar_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Background="#1E1E2E"
                CornerRadius="20"
                Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Buscar Libro (Título):" Foreground="#8888A0" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtBuscar" Width="250" Height="32" TextChanged="txtBuscar_TextChanged"/>
                </StackPanel>

                <DataGrid x:Name="dgLibros" Grid.Row="1"
                          Background="#2A2A40" 
                          Foreground="Black"
                          RowBackground="White"
                          AlternatingRowBackground="#F0F0F0"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionChanged="dgLibros_SelectionChanged"/>
            </Grid>
        </Border>
    </Grid>
</Window>