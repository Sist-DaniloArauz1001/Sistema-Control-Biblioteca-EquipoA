<Window x:Class="SistemaBiblioteca.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Library - Panel Principal"
        Height="450"
        Width="750"
        Background="#12121C"
        WindowStartupLocation="CenterScreen">

	<Window.Resources>

		<LinearGradientBrush x:Key="BotonDegradado" StartPoint="0,0" EndPoint="1,1">
			<GradientStop Color="#A12BFF" Offset="0.0"/>
			<GradientStop Color="#2B6BFF" Offset="0.5"/>
			<GradientStop Color="#00D2FF" Offset="1.0"/>
		</LinearGradientBrush>

		<Style x:Key="BotonEstilo" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource BotonDegradado}"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>

			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="15,10">
							<ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>

			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Opacity" Value="0.8"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="PanelOscuro" TargetType="Border">
			<Setter Property="Background" Value="#1E1E2E"/>
			<Setter Property="CornerRadius" Value="25"/>
		</Style>

	</Window.Resources>

	<Grid>

		<Border Style="{StaticResource PanelOscuro}" Margin="50">

			<Grid>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0"
                            Margin="0,40,0,20"
                            HorizontalAlignment="Center">

					<TextBlock Text="NEXUS LIBRARY"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Black"
                               HorizontalAlignment="Center"/>

					<TextBlock Text="Sistema de Control - Universidad Martín Lutero"
                               Foreground="#8888A0"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
				</StackPanel>

				<StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

					<Button Style="{StaticResource BotonEstilo}"
                            Width="200"
                            Height="60"
                            Content="Gestión de Libros"
                            Margin="0,0,30,0"/>

					<Button Style="{StaticResource BotonEstilo}"
                            Width="200"
                            Height="60"
                            Content="Control de Préstamos"
                            Click="BtnAbrirPrestamos_Click"/>
				</StackPanel>

				<TextBlock Grid.Row="2"
                           Text="● Interfaz principal lista para integración"
                           Foreground="#00D2FF"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"
                           FontSize="12"
                           FontWeight="SemiBold"/>

			</Grid>

		</Border>

	</Grid>

</Window>