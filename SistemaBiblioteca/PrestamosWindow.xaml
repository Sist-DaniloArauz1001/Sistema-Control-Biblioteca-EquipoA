<Window x:Class="SistemaBiblioteca.PrestamosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control de Préstamos"
        Height="650"
        Width="950"
        Background="#12121C"
        WindowStartupLocation="CenterScreen">

	<Grid Margin="20">

		<Border Background="#1E1E2E"
                CornerRadius="20"
                Padding="20">

			<Grid>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<TextBlock Text="CRUD DE PRÉSTAMOS"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

				<!-- FORMULARIO -->

				<StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,20">

					<TextBox x:Name="TxtEstudiante"
                             Width="180"
                             Height="35"
                             Margin="5"/>

					<TextBox x:Name="TxtLibro"
                             Width="180"
                             Height="35"
                             Margin="5"/>

					<DatePicker x:Name="DpPrestamo"
                                Width="150"
                                Margin="5"/>

					<DatePicker x:Name="DpEntrega"
                                Width="150"
                                Margin="5"/>

				</StackPanel>

				<!-- BOTONES -->

				<StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20">

					<Button Content="Guardar"
                            Width="120"
                            Height="40"
                            Margin="5"
                            Background="#00D2FF"
                            Foreground="White"
                            Click="BtnGuardar_Click"/>

					<Button Content="Eliminar"
                            Width="120"
                            Height="40"
                            Margin="5"
                            Background="#FF4B5C"
                            Foreground="White"
                            Click="BtnEliminar_Click"/>

					<Button Content="Actualizar"
                            Width="120"
                            Height="40"
                            Margin="5"
                            Background="#7C4DFF"
                            Foreground="White"
                            Click="BtnActualizar_Click"/>

				</StackPanel>

				<!-- TABLA -->

				<DataGrid x:Name="TablaPrestamos"
                          Grid.Row="3"
                          AutoGenerateColumns="True"
                          SelectionChanged="TablaPrestamos_SelectionChanged"/>

			</Grid>

		</Border>

	</Grid>

</Window>